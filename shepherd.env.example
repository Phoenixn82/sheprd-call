# Sheprd configuration. Copy to ~/.config/shepherd/shepherd.env on each machine; both units read it
# (EnvironmentFile=). Every value below is the default, so an empty file runs everything on one machine.
# systemd expands nothing here ($VARS stay literal); Sheprd itself expands a leading ~ in every path knob.

# --- the bridge (bridge.py): the machine running Herdr and the Claude Code desk ---
# Address the bridge listens on; use the machine's tailnet address when the voice runs elsewhere.
VOICE_SESSION_HOST=127.0.0.1
# Port the bridge listens on.
VOICE_SESSION_PORT=7863
# Comma-separated caller IPs allowed to reach the bridge (the voice host); everyone else gets 404.
VOICE_ALLOWED=127.0.0.1
# Voice host: a custom domain (not an IP, a one-label name or *.ts.net) the call page is served on; comma list.
VOICE_PAGE_HOSTS=
# The desk's working directory (its Herdr tab opens here; ~ is your home).
VOICE_WORKDIR=~
# State folder: today's session id, the turn log, the desk prompt, handoff.json.
VOICE_STATE=~/.local/state/shepherd
# Model the desk runs.
VOICE_CLAUDE_MODEL=claude-opus-5-5
# Extra Claude Code arguments for the desk (shell-split). The default skips permission prompts, so the desk acts
# without asking; the spoken read-back rule is what guards outward actions. Set to "" to keep prompts on.
VOICE_CLAUDE_ARGS=--dangerously-skip-permissions
# Your own desk rules, appended to the built-in prompt; a missing file means none.
VOICE_DESK_ADDENDUM=~/.config/shepherd/desk-addendum.md
# Sign-in links a tool may frame on the call screen (written to VOICE_STATE/handoff.json): a regex the whole URL must
# match. Empty means no handoffs. Name your own handoff service's host and path, never a whole domain, and
# single-quote it, e.g. 'https://mybox[.]mytailnet[.]ts[.]net/web-handoff/h/[A-Za-z0-9_-]{16,64}'.
VOICE_HANDOFF_URL_RE=
# Where photos and videos shared on a call land for the desk (default <VOICE_WORKDIR>/.shepherd/call-media).
VOICE_MEDIA_ROOT=
# A desk past this many context tokens is swapped for a fresh one at the next safe point.
VOICE_DESK_SWAP_TOKENS=200000
# ssh host of the voice machine for call-show; empty copies images on this machine. call-show reads this file itself
# (with VOICE_SHOWN_DIR and VOICE_STATE), so set them here, not only in a unit, on the machine running the desk.
VOICE_SHOW_SSH=
# Your goal per tab for the desk's [on screen: ...] note: a URL answering JSON [{"pane_id", "goal"}] (GET, 3 s
# timeout, cached 30 s); empty means no goals.
VOICE_GOALS_URL=
# MCP config the desk starts with (--mcp-config); empty means desk-mcp.json next to bridge.py.
VOICE_DESK_MCP=
# A command told of each running desk, with its session id and tab id appended (shell-split); empty means none.
VOICE_DESK_REGISTER=
# A command that gets the after-call recheck's one-line notice as its last argument (shell-split); empty means none.
VOICE_NOTIFY=

# --- the voice (bot.py, media.py, shown.py, recheck.py) ---
# The bridge's URL as the voice host reaches it.
VOICE_SESSION_URL=http://127.0.0.1:7863
# Folder of images shown on the call screen; also call-show's target folder (default VOICE_STATE/shown).
VOICE_SHOWN_DIR=
# Folder for phone uploads before they go to the desk (default VOICE_STATE/uploads).
VOICE_UPLOADS_DIR=
# Folder for each call's saved turns, re-transcribed after the call by recheck.py (default VOICE_STATE/calls).
VOICE_CALLS_DIR=
# Your speech-recognition word list, hint and eval set as JSON ({"vocab", "prompt", "set"}; see stt_eval.py). A
# missing file means stt_eval.py's generic sample.
VOICE_STT_VOCAB=~/.config/shepherd/stt-vocab.json
# Folder holding Piper voices, for VOICE_TTS=piper:<id>.
VOICE_PIPER_DIR=~/.local/share/shepherd/voices
# Text-to-speech voice: a Kokoro voice id, or piper:<id>.
VOICE_TTS=af_heart
